# Set this locally. Never put a key in frontend code or commit your .env file.
# If GEMINI_API_KEY is already exported in your shell, it takes precedence over this file.
GEMINI_API_KEY=
# Fast primary model; the fallback is tried once if the primary is busy, slow, or fails evidence checks.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Gemini 3 thinking level. Leave empty for models that do not support thinkingLevel.
GEMINI_THINKING_LEVEL=low
